PORT=8000
NODE_ENV=development

# MySQL Database URL
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Note: When running on Docker with the included docker-compose.yml, port is 3307 to avoid conflict with Windows MySQL80 service.
DATABASE_URL="mysql://root:password@localhost:3307/ctpsms"

# JWT Secret for dashboard session tokens
JWT_SECRET="ctpsms-super-secret-jwt-key-change-in-production"

# Default API Key for local development testing
DEFAULT_API_KEY="system-user-api-key"

# CORS Allowed Origins
CORS_ORIGIN="*"

