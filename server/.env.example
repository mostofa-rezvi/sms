PORT=8000
NODE_ENV=development

# PostgreSQL Database URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# For local host running against Docker PostgreSQL:
DATABASE_URL="postgresql://postgres:password@localhost:5432/ctpsms?schema=public"

# JWT Secret for dashboard session tokens
JWT_SECRET="ctpsms-super-secret-jwt-key-change-in-production"

# Default API Key for local development testing
DEFAULT_API_KEY="system-user-api-key"

# CORS Allowed Origins
CORS_ORIGIN="*"
